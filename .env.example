RELIC_AGENT_OUTPUT_ROOT=outputs
RELIC_AGENT_INSPECTOR_PORT=8765

# Docker Compose bind-mount identity. Check with: id -u && id -g
RELIC_AGENT_UID=1000
RELIC_AGENT_GID=1000

# Optional live provider values; deterministic examples need neither.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
REVIEW_API_KEY=
REVIEW_BASE_URL=https://api.anthropic.com
